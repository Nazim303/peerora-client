{
  "name": "peerora-client",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "main": "electron.cjs",
  
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:exe": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "hls.js": "^1.7.1",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.theosdev.peerora",
    "productName": "Peerora",
    "directories": {
      "output": "release-exe"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "public/**/*"
